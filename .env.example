WEAVIATE_URL=[YOUR_WEAVIATE_INSTANCE].gcp.weaviate.cloud
WEAVIATE_API_KEY=[YOUR_WEAVIATE_API_KEY]
WEAVIATE_API_KEY_VIEWER=[YOUR_WEAVIATE_API_KEY_VIEWER]
COLLECTION_NAME=[YOUR_COLLECTION_NAME]
WATCHLIST_JSON_PATH=[PATH_TO_YOUR_WATCHLIST_JSONL]
LOCAL_OUTPUT_PATH=[PATH_TO_YOUR_LOCAL_OUTPUT_JSONL]

# Google API key (required for Gemini LLM and web search)
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY]

# Model selection (see https://ai.google.dev/gemini-api/docs/models)
# Stable: gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite
# Preview: gemini-3-pro-preview, gemini-3-flash-preview
DEFAULT_PLANNER_MODEL="gemini-2.5-flash"
DEFAULT_WORKER_MODEL="gemini-2.5-flash-lite"
DEFAULT_EVALUATOR_MODEL="gemini-2.5-flash"
